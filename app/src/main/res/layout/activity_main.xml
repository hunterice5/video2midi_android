<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"
            android:textColor="@color/primary_text"/>

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_music_note"
            android:layout_marginBottom="8dp"
            android:contentDescription="@string/app_icon"/>

        <TextView
            android:id="@+id/tvVideoPath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/no_video_selected"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="8dp"
            android:textColor="@color/secondary_text"/>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginBottom="24dp"
            android:textColor="@color/secondary_text"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💡 Recommendation / คำแนะนำ:\n• For best results, use 1080p 60fps or 120fps videos.\n• 30fps videos may cause notes to merge (stick together) due to low frame rate.\n• You can download 60fps/120fps videos using YTDLnis: https://github.com/deniscerri/ytdlnis\n\n• เพื่อผลลัพธ์ที่ดีที่สุด ควรใช้วิดีโอ 1080p 60fps หรือ 120fps\n• วิดีโอ 30fps อาจทำให้โน้ตเล่นติดกัน (โน้ตควบ) เนื่องจากเฟรมเรตต่ำเกินไป\n• แนะนำให้ดาวน์โหลดวิดีโอ 60fps/120fps ผ่านแอป YTDLnis: https://github.com/deniscerri/ytdlnis"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="start"
            android:layout_marginBottom="16dp"
            android:padding="12dp"
            android:background="#1A00E676"
            android:textColor="#00E676"/>

        <Button
            android:id="@+id/btnSelectVideo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/select_video"
            android:textSize="16sp"
            android:layout_marginBottom="12dp"
            android:backgroundTint="@color/primary"/>

        <Button
            android:id="@+id/btnPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/preview"
            android:textSize="16sp"
            android:layout_marginBottom="12dp"
            android:enabled="false"
            android:backgroundTint="@color/primary"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btnSettings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings"
                android:textSize="16sp"
                android:backgroundTint="@color/accent"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_description"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginTop="32dp"
            android:textColor="@color/secondary_text"/>

    </LinearLayout>
</ScrollView>